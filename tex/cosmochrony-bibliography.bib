@misc{Beau2026bim,
  author = {Beau, J\'er\^ome},
  title = {{The Born--Infeld Saturation Margin of the Chiral Modulus: Antisymmetric Structure, Lorentzian Genus, and Electric Determination of the Generation Split}},
  journal = {Working paper},
  year = {2026},
  note = {Fermionic matter sub-programme companion note to PRS. Discharges the PRS open deliverable on the Lorentzian saturation functional: definition of the Lorentzian saturation functional $\mathcal{B}_{\mathrm{sat}}(s)$ along the $J_\Pi$-odd modulus controlling the three-generation split coefficient $u$. Three results: (i)~antisymmetry lemma --- the generation modulus is $J_\Pi$-odd and the symmetric square $M = F_\chi F_\chi$ is $J_\Pi$-even from birth, so the primary modulus variable must be an antisymmetric chiral two-form $F_{\chi,\mu\nu}(s)$; (ii)~$\mathcal{B}_{\mathrm{sat}}(s)$ defined as the Born--Infeld determinantal saturation margin of this two-form, with sign locked by the admissibility role of $\mathcal{B}_{\mathrm{sat}}$ (axiom A4 selects saturated minima), not by Maxwell weak-field matching; (iii)~genus reduction --- $\mu_\chi := \partial_s^2 \mathcal{B}_{\mathrm{sat}}(0) = \tfrac{1}{2} P_{\chi,\mu\nu} P_\chi^{\mu\nu}$, so the existence and stability of the split are governed entirely by the Lorentzian genus of the chiral polarisation $P_\chi$ in the effective metric $g^{\mu\nu} = 2\eta^{\mu\nu}$. In the Schur-transverse branch closed in PRS the chiral polarisation is electric in the effective Lorentzian metric, so $\mu_\chi^2 < 0$ and the $J_\Pi$-symmetric branch is unstable, the split opening spontaneously; the absolute amplitude and the boundary-versus-interior normalisation are left to the downstream construction,
 \doi{10.5281/zenodo.20633931}}
}

@misc{Beau2026ebj,
  author = {Beau, J\'er\^ome},
  title = {{The Constrained Jet of the Lorentzian Eliminated Block and the Chiral Defect-Rate Identity: A Moving-Schur Existence Theorem for the Generation Split}},
  journal = {Working paper},
  year = {2026},
  note = {Fermionic matter sub-programme companion note, logically between the Schur reduction (PRS) and the physical identification of the chiral generator. For every smooth self-adjoint projector family $1-P(s) = Q_0 + sQ_1 + s^2Q_2 + O(s^3)$ the projector constraints force $Q_1 = [A, Q_0]$ to be a purely off-diagonal Grassmann tangent and pin the diagonal blocks of $Q_2$ to $Q_1^2$ with opposite signs; the jet parities alternate under $J_\Pi$-equivariance. With a moving spinorial embedding and a $J_\Pi$-even Dirac operator the first-order $J_\Pi$-odd part of $E_\Pi^2$ is $\{E_0, E_1\}$, and antiunitary parity makes every odd-order generation-mixing coefficient vanish, mixing at even orders not being excluded. An explicit covariant moving-Schur family realises $E_0^2 = \mathrm{diag}(1, \tfrac12, \tfrac12)$ with a non-zero split rate $u'(0) = 11 \cdot 2^{1/4}/9$. In the chiral frame $[\Pi_{J_\Pi\text{-odd}}\dot Q(0)]_{LL} = \tfrac12\partial_s\Delta_\chi(P)|_0$ determines one block of the odd tangent, not a unique generator; the selection of the family, the localisation, and the normalisation of $|u|$ remain open,
 \doi{10.5281/zenodo.20763532}}
}

